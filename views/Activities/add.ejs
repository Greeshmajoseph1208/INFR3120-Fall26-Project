
<%- include ../partials/header.ejs %>
<%- include ../partials/main_nav.ejs %>

<main class="container" style="padding-bottom: 120px;">
    <h1><%= title %></h1>

    <!--Activity Form-->

    <form action="/activities/add" method="POST">

        <p>
            <label for="name">Activity Name :</label>
            <input type="text" id="name" name="name" size="32"
            placeholder="Enter activity name" required>
        </p>

        <p>
            <label for="course">Course :</label>
            <input type="text" id="course" name="course" size="32"
            placeholder="Enter course name" required>
        </p>

        <p>
            <label for="dueDate">Due Date :</label>
            <input type="date" id="dueDate" name="dueDate" required>
        </p>

        <p>
            <label for="comment">Comment :</label>
            <br>
            <textarea id="comment" name="comment"
            cols="60" rows="6"></textarea>
        </p>

        <p>
            <label for="status">Activity Status :</label>
            <select id="status" name="status">
                <option value="Pending">Pending</option>
                <option value="In Progress">In Progress</option>
                <option value="Completed">Completed</option>
            </select>
        </p>

        <input type="submit" value="Add Activity">
        <input type="reset" value="Reset Form">

    </form>
</main>


<%- include ../partials/footer.ejs %>
