<%- include ../partials/header.ejs %>
<%- include ../partials/main_nav.ejs %>

<!-- Main content -->
<main class="container">
    <div class="row">
        <div class="offset-md-1 col-md-10">
            <h1><%= title %></h1>
            <br>

            <table class="table table-bordered table-striped table-hover">
                <!-- Header Row -->
                <tr>
                    <th>Name</th>
                    <th>Course</th>
                    <th>Due Date</th>
                    <th>Comment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>

                <!-- Activity Items -->
                <% for(let count=0; count<Activitylist.length; count++) { %>
                    <tr>
                        <td><%= Activitylist[count].name %></td>
                        <td><%= Activitylist[count].course %></td>
                        <td><%= Activitylist[count].dueDate ? Activitylist[count].dueDate.toISOString().split('T')[0] : '' %></td>
                        <td><%= Activitylist[count].comment %></td>
                        <td><%= Activitylist[count].status %></td>
                        <td>
                            <a href="/activities/edit/<%= Activitylist[count]._id %>" class="btn btn-sm btn-primary">Edit</a>

                            <form action="/activities/complete/<%= Activitylist[count]._id %>" method="POST" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
                            </form>

                            <form action="/activities/delete/<%= Activitylist[count]._id %>" method="POST" style="display:inline"
                                  onsubmit="return confirm('Delete this activity?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </table>
        </div>
    </div>
</main>

<%- include ../partials/footer.ejs %>